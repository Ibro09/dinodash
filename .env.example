
# ===== SOLANA NETWORK CONFIGURATION =====
# Choose network: 'devnet' or 'mainnet'
VITE_SOLANA_NETWORK=devnet

# Devnet RPC URL
VITE_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Mainnet RPC URL (optional alternative)
VITE_SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Treasury wallet address
VITE_TREASURY_WALLET=YOUR_TREASURY_WALLET_ADDRESS

# ===== DATABASE CONFIGURATION =====
# MONGODB_URI: MongoDB connection string (e.g. mongodb://localhost:27017/solana-p2e)
MONGODB_URI="mongodb://localhost:27017/solana-p2e"

# Treasury secret key (for backend operations)
TREASURY_SECRET_KEY=YOUR_TREASURY_SECRET_KEY
